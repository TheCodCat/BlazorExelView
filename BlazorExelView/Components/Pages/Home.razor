@page "/"
@rendermode InteractiveServer
@using BlazorExelView.model
@using services
@inject FileExelService exelSystem
<PageTitle>Поручения</PageTitle>

<MudStack Row="false" Style="width : 30%">
        <MudButton OnClick="@LoadData" Variant="Variant.Filled" Color="Color.Primary">
            Получить таблицу
        </MudButton>

        <MudTextField T="string" @bind-Value="@urlYandex" Label="Ссылка на таблицу" Variant="Variant.Text"></MudTextField>

        <MudText Typo="Typo.body1">
            Выберите назвние таблицы
        </MudText>

    @if (dataWorkers.Any())
    {
        <select @onchange="@ChangePage"
                class="form-select">
            @foreach (var worker in dataWorkers)
            {
                <option value="@worker.Key">@worker.Key</option>
            }
        </select>
    }
    </MudStack>


@if (values != null)
{
    @if (values.Any())
    {
        <MudTable Items="@values">

            <ToolBarContent>
                <MudText Typo="Typo.h2">Поручения</MudText>
            </ToolBarContent>
            <HeaderContent>

                <MudTh Typo="Typo.h6">ID</MudTh>
                <MudTh Typo="Typo.h6">Исполнитель</MudTh>
                <MudTh Typo="Typo.h6">Значение</MudTh>
                <MudTh Typo="Typo.h6">Поручение</MudTh>

            </HeaderContent>

            <RowTemplate>
                <MudTd @attributes="context.classBG">@context.IDView</MudTd>
                <MudTd @attributes="context.classBG">@context.Name</MudTd>
                <MudTd @attributes="context.classBG">@context.State</MudTd>
                <MudTd @attributes="context.classBG">@context.Description</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Class="mt-4">Файл не загружен или пуст</MudText>
    }

}


@code {
    List<Worker> values = new List<Worker>();
    Dictionary<string, List<Worker>> dataWorkers = new Dictionary<string, List<Worker>>();
    string urlYandex = "https://disk.yandex.ru/i/VHKmAv08izIWsw";

    private async Task LoadData()
    {
        //dataWorkers = await exelSystem.LoadFilePages("per_2026.xlsx");
        dataWorkers = await exelSystem.LoadFilePages(urlYandex);
        if (dataWorkers.Any())
            values = dataWorkers.Values.First();
        else
            values = new List<Worker>();
    }

    private async void ChangePage(ChangeEventArgs arg)
    {
        var result = dataWorkers[arg.Value.ToString()];
        values = result;
    }
}
